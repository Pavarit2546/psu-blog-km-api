# Copy to .env and replace every <PLACEHOLDER>. Never commit .env.
# Generate secrets with e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use URL-safe values (hex) for passwords that appear inside DATABASE_URL.

# --- Payload / Next.js ---------------------------------------------------
PAYLOAD_SECRET=<PLACEHOLDER_64_HEX_CHARS>
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
# Interface the app port binds to (127.0.0.1 = this machine only; 0.0.0.0 = LAN demo, e.g. phone testing)
APP_BIND=127.0.0.1
# Set to true when served over HTTPS
COOKIE_SECURE=false
# mock = development-only demo login (NOT PSU SSO). oidc = planned PSU SSO (not implemented)
AUTH_PROVIDER=mock

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<PLACEHOLDER_HEX>
APP_DB_USER=psu_kp_app
APP_DB_PASSWORD=<PLACEHOLDER_HEX>
APP_DB_NAME=psu_kp
APP_TEST_DB_NAME=psu_kp_test
# Used by host-side tools (pnpm dev / migrate / tests) via docker-compose.dev.yml (port 5533).
# Inside Docker the app builds its own DATABASE_URL from the values above.
DATABASE_URL=postgres://psu_kp_app:<PLACEHOLDER_HEX>@127.0.0.1:5533/psu_kp

# --- MinIO (S3-compatible object storage) ----------------------------------
MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_ACCESS_KEY=<PLACEHOLDER>
MINIO_SECRET_KEY=<PLACEHOLDER_HEX>
MINIO_BUCKET=psu-knowledge-media
MINIO_REGION=us-east-1

# --- Demo seed (development only) -----------------------------------------
# Password for all synthetic demo accounts created by `pnpm seed`.
SEED_DEMO_PASSWORD=<PLACEHOLDER_DEMO_PASSWORD>

# --- Backups ---------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

PSU_KP_BASE_URL=http://localhost:3100
